// Matches the kitty Solarized Dark colors in rc.d/kitty/dark-theme.auto.conf.
// Solarized key (RGB):
//   base03 0 43 54      base02 7 54 66      base01 88 110 117   base00 101 123 131
//   base0 131 148 150   base1 147 161 161   base2 238 232 213   base3 253 246 227
//   yellow 181 137 0    orange 203 75 22    red 220 50 47       magenta 211 54 130
//   violet 108 113 196  blue 38 139 210     cyan 42 161 152     green 133 153 0
themes {
    solarized-kitty-dark {
        text_unselected {
            base 131 148 150
            background 0 43 54
            emphasis_0 203 75 22
            emphasis_1 42 161 152
            emphasis_2 133 153 0
            emphasis_3 211 54 130
        }
        text_selected {
            base 131 148 150
            background 7 54 66
            emphasis_0 203 75 22
            emphasis_1 42 161 152
            emphasis_2 133 153 0
            emphasis_3 211 54 130
        }
        // Tabs and mode indicators; mirrors kitty's tab bar (active = high contrast).
        ribbon_selected {
            base 0 43 54
            background 147 161 161
            emphasis_0 220 50 47
            emphasis_1 203 75 22
            emphasis_2 211 54 130
            emphasis_3 38 139 210
        }
        ribbon_unselected {
            base 131 148 150
            background 7 54 66
            emphasis_0 220 50 47
            emphasis_1 203 75 22
            emphasis_2 38 139 210
            emphasis_3 211 54 130
        }
        table_title {
            base 133 153 0
            background 0 43 54
            emphasis_0 203 75 22
            emphasis_1 42 161 152
            emphasis_2 133 153 0
            emphasis_3 211 54 130
        }
        table_cell_selected {
            base 131 148 150
            background 7 54 66
            emphasis_0 203 75 22
            emphasis_1 42 161 152
            emphasis_2 133 153 0
            emphasis_3 211 54 130
        }
        table_cell_unselected {
            base 131 148 150
            background 0 43 54
            emphasis_0 203 75 22
            emphasis_1 42 161 152
            emphasis_2 133 153 0
            emphasis_3 211 54 130
        }
        list_selected {
            base 131 148 150
            background 7 54 66
            emphasis_0 203 75 22
            emphasis_1 42 161 152
            emphasis_2 133 153 0
            emphasis_3 211 54 130
        }
        list_unselected {
            base 131 148 150
            background 0 43 54
            emphasis_0 203 75 22
            emphasis_1 42 161 152
            emphasis_2 133 153 0
            emphasis_3 211 54 130
        }
        // Pane borders: kitty's active (orange) / inactive border colors.
        frame_unselected {
            base 88 110 117
            background 0
            emphasis_0 203 75 22
            emphasis_1 42 161 152
            emphasis_2 211 54 130
            emphasis_3 0
        }
        frame_selected {
            base 203 75 22
            background 0
            emphasis_0 42 161 152
            emphasis_1 133 153 0
            emphasis_2 211 54 130
            emphasis_3 0
        }
        frame_highlight {
            base 38 139 210
            background 0
            emphasis_0 211 54 130
            emphasis_1 203 75 22
            emphasis_2 203 75 22
            emphasis_3 203 75 22
        }
        exit_code_success {
            base 133 153 0
            background 0
            emphasis_0 42 161 152
            emphasis_1 0 43 54
            emphasis_2 211 54 130
            emphasis_3 38 139 210
        }
        exit_code_error {
            base 220 50 47
            background 0
            emphasis_0 181 137 0
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 211 54 130
            player_2 38 139 210
            player_3 133 153 0
            player_4 181 137 0
            player_5 42 161 152
            player_6 203 75 22
            player_7 220 50 47
            player_8 108 113 196
            player_9 147 161 161
            player_10 88 110 117
        }
    }
}
